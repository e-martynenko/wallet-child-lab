{
  "name": "wallet-child-lab",
  "version": "0.0.0",
  "private": true,
  "description": "A Devnet-first lab for learning Metaplex agent identity and wallet primitives.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:deps": "pnpm audit --prod",
    "birth:devnet": "tsx src/cli/birth-devnet.ts",
    "brain:check": "tsx src/cli/check-brain.ts",
    "bootstrap:quote:mainnet": "tsx src/cli/quote-bootstrap-mainnet.ts",
    "bootstrap:simulate:mainnet": "tsx src/cli/simulate-bootstrap-mainnet.ts",
    "check:network": "tsx src/cli/check-network.ts",
    "delegates:audit:devnet": "tsx src/cli/audit-delegates-devnet.ts",
    "delegates:audit:mainnet": "tsx src/cli/audit-delegates-mainnet.ts",
    "execute:devnet": "tsx src/cli/execute-bounded-devnet.ts",
    "fund:devnet": "tsx src/cli/fund-devnet.ts",
    "lifecycle:devnet": "tsx src/cli/lifecycle-devnet.ts",
    "metadata:check": "tsx src/cli/check-metadata.ts",
    "metadata:fund:mainnet": "tsx src/cli/fund-irys-mainnet.ts",
    "metadata:plan:mainnet": "tsx src/cli/plan-metadata-mainnet.ts",
    "metadata:quote:irys": "tsx src/cli/quote-irys-metadata.ts",
    "metadata:review-action:mainnet": "tsx src/cli/review-irys-action-mainnet.ts",
    "metadata:verify-durable": "tsx src/cli/verify-durable-metadata.ts",
    "messages:quote:mainnet": "tsx src/cli/quote-internal-mainnet.ts",
    "policy:check": "tsx src/cli/check-policy.ts",
    "prepare:mainnet-recovery": "tsx src/cli/prepare-mainnet-recovery.ts",
    "prepare:mainnet-identity": "tsx src/cli/prepare-mainnet-identity.ts",
    "prepare:mainnet-wallets": "tsx src/cli/prepare-mainnet-wallets.ts",
    "readiness:mainnet": "tsx src/cli/check-mainnet-readiness.ts",
    "status:devnet": "tsx src/cli/status-devnet.ts",
    "test-token:devnet": "tsx src/cli/execute-test-token-devnet.ts",
    "treasury:quote:mainnet": "tsx src/cli/quote-usdc-funding-mainnet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
